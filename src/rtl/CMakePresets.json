{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "verilator/Release",
            "displayName": "verilator/Release",
            "description": "The verilated machine and the whole test suite, optimized.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../build/verilator/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RP6502_RTL_SIM": "ON"
            }
        },
        {
            "name": "verilator/Debug",
            "displayName": "verilator/Debug",
            "description": "The same, unoptimized, for stepping through a testbench.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../build/verilator/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RP6502_RTL_SIM": "ON"
            }
        },
        {
            "name": "pocket",
            "displayName": "pocket",
            "description": "The Analogue Pocket core. Quartus and a RISC-V compiler; no Verilator, no tests. There is no Debug because CMAKE_BUILD_TYPE does not reach a bitstream.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../build/pocket",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RP6502_RTL_SIM": "OFF"
            }
        },
        {
            "name": "quartus/synth",
            "displayName": "quartus/synth",
            "description": "Area and timing only, all pins virtual. A tree of its own so a measurement never disturbs a real fit.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../build/quartus/synth",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RP6502_RTL_SIM": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Tests",
            "displayName": "Tests",
            "configurePreset": "verilator/Release"
        },
        {
            "name": "Firmware",
            "displayName": "Firmware",
            "configurePreset": "verilator/Release",
            "targets": ["sw_bin"]
        },
        {
            "name": "Tests (Debug)",
            "displayName": "Tests",
            "configurePreset": "verilator/Debug"
        },
        {
            "name": "Firmware (Debug)",
            "displayName": "Firmware",
            "configurePreset": "verilator/Debug",
            "targets": ["sw_bin"]
        },
        {
            "name": "Card package",
            "displayName": "Card package",
            "configurePreset": "pocket",
            "targets": ["pocket"]
        },
        {
            "name": "Bitstream",
            "displayName": "Bitstream",
            "configurePreset": "pocket",
            "targets": ["pocket-bitstream"]
        },
        {
            "name": "Machine",
            "displayName": "Machine",
            "configurePreset": "quartus/synth",
            "targets": ["synth"]
        },
        {
            "name": "Pocket core",
            "displayName": "Pocket core",
            "configurePreset": "quartus/synth",
            "targets": ["pocket-synth"]
        }
    ],
    "testPresets": [
        {
            "name": "verilator/Release",
            "displayName": "Tests",
            "configurePreset": "verilator/Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "verilator/Debug",
            "displayName": "Tests",
            "configurePreset": "verilator/Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
