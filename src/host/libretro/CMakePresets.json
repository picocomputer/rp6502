{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../../build/libretro/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "description": "Disable optimizations - include debug information."
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../../../build/libretro/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "description": "Optimized for speed - exclude debug information."
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "displayName": "Tests",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 16
            }
        },
        {
            "name": "release",
            "displayName": "Tests",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 16
            }
        }
    ]
}
