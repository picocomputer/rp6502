// Analogue's template code is not written for -Wall, and the bench that
// holds it has the template's two small modules beside its own.
`verilator_config
lint_off -file "*vendor/openfpga_rp6502/core_bridge_cmd.v"
lint_off -rule COMBDLY -file "*vendor/openfpga_rp6502/core_bridge_cmd.v"
lint_off -rule INITIALDLY -file "*vendor/openfpga_rp6502/core_bridge_cmd.v"
lint_off -rule DECLFILENAME -file "*tests/host/pocket/tb_psst.sv"
