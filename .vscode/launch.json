{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "romPick",
            "type": "pickString",
            "description": "Pick a .rp6502 ROM from tests/roms",
            "default": "adventure.rp6502",
            "options": [
                "adventure.rp6502",
                "exec.rp6502",
                "rtc.rp6502",
                "dir.rp6502",
                "mode2.rp6502",
                "furelise.rp6502",
                "paint_mouse.rp6502",
                "paint_tablet.rp6502",
                "gamepad.rp6502"
            ]
        },
        {
            "id": "romPath",
            "type": "promptString",
            "description": "Path to a .rp6502 ROM (relative paths resolve from the workspace folder)",
            "default": "tests/roms/adventure.rp6502"
        }
    ],
    "configurations": [
        {
            "name": "Emulator Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu",
            "args": [
                "--debug",
                "${workspaceFolder}/tests/roms/${input:romPick}"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "emu: Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "blank = disable debuginfod, else gdb hangs downloading before main() (WSL/cppdbg)",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "linux": {
                "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu"
            },
            "osx": {
                "program": "${workspaceFolder}/build/sokol/macos/debug/rp6502-emu"
            },
            "windows": {
                "program": "${workspaceFolder}/build/sokol/windows/debug/rp6502-emu.exe"
            }
        },
        {
            "name": "Emulator Debug (no ROM)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu",
            "args": [
                "--debug"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "emu: Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "blank = disable debuginfod, else gdb hangs downloading before main() (WSL/cppdbg)",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "linux": {
                "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu"
            },
            "osx": {
                "program": "${workspaceFolder}/build/sokol/macos/debug/rp6502-emu"
            },
            "windows": {
                "program": "${workspaceFolder}/build/sokol/windows/debug/rp6502-emu.exe"
            }
        },
        {
            "name": "Emulator Debug (path…)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu",
            "args": [
                "--debug",
                "${input:romPath}"
            ],
            // rom.c resolves a bare path against the process cwd, so a typed
            // relative path needs a base anyone can predict.
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "emu: Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "blank = disable debuginfod, else gdb hangs downloading before main() (WSL/cppdbg)",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "linux": {
                "program": "${workspaceFolder}/build/sokol/linux/debug/rp6502-emu"
            },
            "osx": {
                "program": "${workspaceFolder}/build/sokol/macos/debug/rp6502-emu"
            },
            "windows": {
                "program": "${workspaceFolder}/build/sokol/windows/debug/rp6502-emu.exe"
            }
        },
        {
            // The core is not a program, so the program is the frontend and
            // the core is what it is told to load. Breakpoints in retro.c
            // bind when RetroArch dlopens it.
            "name": "RetroArch Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/retroarch",
            "args": [
                "-L",
                "${workspaceFolder}/build/libretro/debug/rp6502_libretro.so",
                "${workspaceFolder}/tests/roms/${input:romPick}"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "libretro: Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "blank = disable debuginfod, else gdb spends minutes fetching symbols for every library RetroArch links",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "linux": {
                "program": "/usr/bin/retroarch",
                // A per-OS block replaces the property outright, so the
                // debuginfod blank has to be repeated here.
                "environment": [
                    {
                        "name": "DEBUGINFOD_URLS",
                        "value": ""
                    },
                    {
                        // WSLg's compositor does not offer server-side
                        // decorations, and RetroArch's Wayland backend draws
                        // none of its own, so the window arrives with no title
                        // bar and no way to close it. Hiding the socket gets
                        // X11, which WSLg gives a real window. Harmless on a
                        // compositor that does decorate.
                        "name": "WAYLAND_DISPLAY",
                        "value": "nonexistent-0"
                    }
                ]
            },
            "osx": {
                "program": "/Applications/RetroArch.app/Contents/MacOS/RetroArch"
            }
        },
        {
            "name": "RetroArch Debug (path…)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/retroarch",
            "args": [
                "-L",
                "${workspaceFolder}/build/libretro/debug/rp6502_libretro.so",
                "${input:romPath}"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "libretro: Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "blank = disable debuginfod, else gdb spends minutes fetching symbols for every library RetroArch links",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                }
            ],
            "linux": {
                "program": "/usr/bin/retroarch",
                "environment": [
                    {
                        "name": "DEBUGINFOD_URLS",
                        "value": ""
                    },
                    {
                        "name": "WAYLAND_DISPLAY",
                        "value": "nonexistent-0"
                    }
                ]
            },
            "osx": {
                "program": "/Applications/RetroArch.app/Contents/MacOS/RetroArch"
            }
        },
        {
            // cmake-tools' launchTargetPath, not the Pico extension's. The
            // Pico one wraps this exact command and, on any failure to
            // resolve, silently substitutes build/<project()>.elf -- which
            // here is build/RP6502.elf, a file no target has ever produced.
            // The other raspberry-pi-pico commands below are fine; they read
            // the SDK install, not the launch target.
            "name": "Pico Debug (Cortex-Debug)",
            "cwd": "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${command:cmake.launchTargetPath}\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Pico Debug (Cortex-Debug with external OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${command:cmake.launchTargetPath}\""
            ]
        },
        {
            "name": "Pico Debug (C++ Debugger)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${command:cmake.launchTargetPath}",
            "MIMode": "gdb",
            "miDebuggerPath": "${command:raspberry-pi-pico.getGDBPath}",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "debugServerArgs": "-f interface/cmsis-dap.cfg -f target/${command:raspberry-pi-pico.getTarget}.cfg -c \"adapter speed 5000\"",
            "serverStarted": "Listening on port .* for gdb connections",
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "preLaunchTask": "Flash",
            "svdPath": "${userHome}/.pico-sdk/sdk/2.3.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd"
        }
    ]
}
