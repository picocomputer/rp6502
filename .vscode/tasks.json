{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:HOME}/.pico-sdk/picotool/2.3.0/picotool/picotool",
            "args": [
                "load",
                "${command:cmake.launchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.0/picotool/picotool.exe"
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-c",
                "set CMAKE_LAUNCH_TARGET {${command:cmake.launchTargetName}}",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-c",
                "adapter speed 5000; program {${command:cmake.launchTargetPath}} verify reset exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
            }
        },
        {
            "label": "Dump Fonts",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/src/core/term/font.py"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "python"
            }
        },
        {
            "label": "emu: Configure (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "linux-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/host/sokol"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "linux": {
                "args": [
                    "--preset",
                    "linux-debug"
                ]
            },
            "osx": {
                "args": [
                    "--preset",
                    "macos-debug"
                ]
            },
            "windows": {
                "command": "cmake",
                "args": [
                    "--preset",
                    "windows-debug"
                ]
            }
        },
        {
            "label": "emu: Build (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "linux-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/host/sokol"
            },
            "dependsOn": "emu: Configure (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "linux": {
                "args": [
                    "--build",
                    "--preset",
                    "linux-debug"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "macos-debug"
                ]
            },
            "windows": {
                "command": "cmake",
                "args": [
                    "--build",
                    "--preset",
                    "windows-debug"
                ]
            }
        },
        {
            "label": "emu: Test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/sokol/linux/debug",
                "--output-on-failure"
            ],
            "dependsOn": "emu: Build (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "linux": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/sokol/linux/debug",
                    "--output-on-failure"
                ]
            },
            "osx": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/sokol/macos/debug",
                    "--output-on-failure"
                ]
            },
            "windows": {
                "command": "ctest",
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/sokol/windows/debug",
                    "--output-on-failure"
                ]
            }
        },
        {
            "label": "libretro: Configure (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/host/libretro"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "libretro: Build (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/host/libretro"
            },
            "dependsOn": "libretro: Configure (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "libretro: Test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/libretro/debug",
                "--output-on-failure"
            ],
            "dependsOn": "libretro: Build (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tests/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tests/rtl"
            },
            "dependsOn": "rtl: Configure",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tests/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "dependsOn": "rtl: Build"
        },
        {
            "label": "pocket: Card package",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/host/pocket"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "vectors: download",
            "type": "process",
            "command": "cmake",
            "args": [
                "-DRP6502_ROOT=${workspaceFolder}",
                "-DFETCH_SUPER=${workspaceFolder}",
                "-DFETCH_PATH=vendor/65x02",
                "-DFETCH_SPARSE=wdc65c02/v1",
                "-P",
                "${workspaceFolder}/submodules.cmake"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
