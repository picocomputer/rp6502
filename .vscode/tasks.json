{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:HOME}/.pico-sdk/picotool/2.3.0/picotool/picotool",
            "args": [
                "load",
                "${command:raspberry-pi-pico.launchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.0/picotool/picotool.exe"
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-c",
                "adapter speed 5000; program \"${command:raspberry-pi-pico.launchTargetPath}\" verify reset exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe"
            }
        },
        {
            "label": "Dump Fonts",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/src/core/term/font.py"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "python"
            }
        },
        {
            "label": "emu: Configure (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/emu"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "emu: Build (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/emu"
            },
            "dependsOn": "emu: Configure (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "emu: Test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/emulator/debug",
                "--output-on-failure"
            ],
            "dependsOn": "emu: Build (Debug)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Firmware",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Firmware"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--preset",
                "verilator/Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "rtl: Area and timing",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Machine"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "pocket: Bitstream",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Bitstream"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "pocket: Card package",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Card package"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "pocket: Area and timing",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Pocket core"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/rtl"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "vectors: download",
            "type": "process",
            "command": "cmake",
            "args": [
                "-DRP6502_ROOT=${workspaceFolder}",
                "-DFETCH_SUPER=${workspaceFolder}",
                "-DFETCH_PATH=vendor/65x02",
                "-DFETCH_SPARSE=wdc65c02/v1",
                "-P",
                "${workspaceFolder}/submodules.cmake"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
